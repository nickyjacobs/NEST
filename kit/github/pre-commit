#!/bin/sh
# Secret scan before every commit: blocks a commit whose staged files hold a secret or a
# private term from .claude/sensitive-terms.txt.
#
# Enable it once per clone:
#   mkdir -p .githooks && cp kit/github/pre-commit .githooks/pre-commit   (the setup does this)
#   chmod +x .githooks/pre-commit                                        (macOS and Linux)
#   git config core.hooksPath .githooks
# Git for Windows runs this file with its bundled sh, so the same hook works there.
# Do not skip it with --no-verify: fix the file instead.

cd "$(git rev-parse --show-toplevel)" || exit 1
if ! command -v uv >/dev/null 2>&1; then
  echo "pre-commit: uv is not on PATH, so the secret scan cannot run and this commit is stopped. Install uv (https://docs.astral.sh/uv/), or commit from a terminal where the command uv works: an app started from the dock or the Start menu may not see it." >&2
  exit 1
fi
exec uv run --quiet --script scripts/validate.py --staged
