{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [],
    "ask": [],
    "deny": []
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "claudeMdExcludes": [],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PROJECT_DIR}/scripts/validate.py", "--hook", "pre"],
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "Scanning for secrets"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PROJECT_DIR}/scripts/session_guard.py", "--event", "lesson"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PROJECT_DIR}/scripts/validate.py", "--hook", "post"],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PROJECT_DIR}/scripts/check_style.py", "--hook"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PROJECT_DIR}/scripts/validate.py", "--hook", "shell"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PROJECT_DIR}/scripts/session_guard.py", "--event", "plan"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PROJECT_DIR}/scripts/validate.py", "--hook", "shell"],
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PROJECT_DIR}/scripts/session_context.py"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PROJECT_DIR}/scripts/session_guard.py", "--event", "start"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PROJECT_DIR}/scripts/session_guard.py", "--event", "prompt"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PROJECT_DIR}/scripts/session_guard.py", "--event", "precompact"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "--script", "${CLAUDE_PROJECT_DIR}/scripts/session_guard.py", "--event", "end"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
