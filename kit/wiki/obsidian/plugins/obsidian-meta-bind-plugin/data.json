{
  "devMode": false,
  "ignoreCodeBlockRestrictions": false,
  "preferredDateFormat": "YYYY-MM-DD",
  "firstWeekday": "Monday",
  "syncInterval": 200,
  "enableJs": false,
  "viewFieldDisplayNullAsEmpty": false,
  "enableSyntaxHighlighting": true,
  "enableEditorRightClickMenu": true,
  "inputFieldTemplates": [],
  "buttonTemplates": [
    {
      "id": "mk-note",
      "label": "Note",
      "icon": "pencil-line",
      "style": "primary",
      "tooltip": "Capture something: a thought, something you read or heard (template note)",
      "action": {
        "type": "templaterCreateNote",
        "templateFile": "_templates/note.md",
        "folderPath": "_inbox",
        "openNote": true
      }
    },
    {
      "id": "mk-question",
      "label": "Question",
      "icon": "message-circle-question",
      "style": "primary",
      "tooltip": "A question for the wiki; /wiki-inbox answers it (template question)",
      "action": {
        "type": "templaterCreateNote",
        "templateFile": "_templates/question.md",
        "folderPath": "_inbox",
        "openNote": true
      }
    },
    {
      "id": "mk-source",
      "label": "Source",
      "icon": "link",
      "style": "primary",
      "tooltip": "Keep a URL to have it ingested later (template source)",
      "action": {
        "type": "templaterCreateNote",
        "templateFile": "_templates/source.md",
        "folderPath": "_inbox",
        "openNote": true
      }
    },
    {
      "id": "mk-research",
      "label": "Research",
      "icon": "microscope",
      "style": "primary",
