      "action": {
        "type": "templaterCreateNote",
        "templateFile": "_templates/knowledge-tool.md",
        "folderPath": "20-knowledge",
        "openNote": true
      }
    },
    {
      "id": "mk-concept",
      "label": "Knowledge (concept)",
      "icon": "brain",
      "style": "primary",
      "tooltip": "New knowledge note about a concept (template knowledge-note)",
      "action": {
        "type": "templaterCreateNote",
        "templateFile": "_templates/knowledge-note.md",
        "folderPath": "20-knowledge",
        "openNote": true
      }
    },
    {
      "id": "mk-project",
